# ITCS355 Lab 3 — serving image
#
# Base image pinned by digest (Lab 1 Task 2 rule applied to the serving image):
#   python@sha256:da047cb8f9d1d98e5c070f5300ba9f7274e33b8fc0e5be5ed88740aed1b95ba9
FROM python@sha256:da047cb8f9d1d98e5c070f5300ba9f7274e33b8fc0e5be5ed88740aed1b95ba9 AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY requirements-serve.txt ./
RUN pip install --prefix=/install -r requirements-serve.txt

FROM python@sha256:da047cb8f9d1d98e5c070f5300ba9f7274e33b8fc0e5be5ed88740aed1b95ba9 AS runtime
RUN useradd --create-home --uid 10001 runner
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY --from=builder /install /usr/local
WORKDIR /app
COPY --chown=runner:runner service/ ./service/
COPY --chown=runner:runner src/ ./src/
COPY --chown=runner:runner cloudlayer/ ./cloudlayer/
USER runner

EXPOSE 8080
# Provider route mapping (Container Apps path — Lab 3 on Azure for Students):
#   Container Apps doesn't mandate specific health/predict paths; the service's
#   own /health, /ready, /predict, /predict/batch are used directly. For
#   SageMaker the adapter would map /ping and /invocations; for Vertex it would
#   declare routes on the Model resource. This image stays portable.
CMD ["uvicorn", "service.app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
